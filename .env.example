# Copy this file to .env.local and fill in the values.
# Online (Vercel), add the same names under Settings → Environment Variables.

# A long random string used to sign sign-in cookies (at least 32 characters).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# PostgreSQL connection string, e.g. Supabase's "Transaction pooler" URI (port 6543).
# Leave empty on your own computer to use a local database in ./data instead.
DATABASE_URL=
